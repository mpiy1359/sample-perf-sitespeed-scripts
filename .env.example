# .env.example
#
# Copy this file to .env and fill in the values for your environment.
# The .env file is listed in .gitignore and should NEVER be committed.

# ── Log verbosity ─────────────────────────────────────────────────────
# Accepted values: error | warn | info | debug
LOG_LEVEL=info

# ── Target URL override ───────────────────────────────────────────────
# When set, this URL is used instead of the one in sitespeed.config.json.
# Useful for pointing the same test suite at different environments.
# SITESPEED_URL=https://staging.example.com/

# ── Results output folder ─────────────────────────────────────────────
# Overrides the outputFolder in sitespeed.config.json.
# SITESPEED_OUTPUT_FOLDER=./results/custom
